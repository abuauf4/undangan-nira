# Prisma CLI needs a local file URL for generate/validation (not used at runtime)
DATABASE_URL="file:./db/local.db"

# Turso — used at runtime by libsql adapter
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="YOUR_AUTH_TOKEN"

# Admin panel password — validated server-side only
ADMIN_PASSWORD="your-secure-password-here"
